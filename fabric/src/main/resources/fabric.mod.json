{
  "schemaVersion": 1,
  "id": "${modId}",
  "name": "${modName}",
  "description": "${modDescription}",
  "contact": {
    "issues": "https://github.com/cschierig/immersive-crafting/issues",
    "sources": "https://github.com/cschierig/immersive-crafting"
  },
  "authors": [
    "CozyPenguin"
  ],
  "version": "${modVersion}",
  "icon": "assets/${modId}/icon.png",
  "license": "${modLicense}",
  "entrypoints": {
    "main": [
      "com.carlschierig.immersivecrafting.ImmersiveCrafting"
    ],
    "client": [
      "com.carlschierig.immersivecrafting.ImmersiveCraftingClient"
    ],
    "fabric-datagen": [
      "com.carlschierig.immersivecrafting.impl.datagen.ICDatagen"
    ],
    "emi": [
      "com.carlschierig.immersivecrafting.compat.emi.ICEmiPlugin"
    ]
  },
  "mixins": [
    "${modId}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": "*",
    "minecraft": "1.21.x",
    "java": ">=21"
  },
  "suggests": {
    "emi": ">=1.0.19"
  }
}
