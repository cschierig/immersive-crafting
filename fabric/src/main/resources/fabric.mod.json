{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "contact": {
    "issues": "https://github.com/cschierig/immersive-crafting/issues",
    "sources": "https://github.com/cschierig/immersive-crafting"
  },
  "authors": [
    "CozyPenguin"
  ],
  "icon": "assets/immersive_crafting/icon.png",
  "license": "${modLicense}",
  "entrypoints": {
    "main": [
      "com.carlschierig.immersivecrafting.ImmersiveCraftingFabric"
    ],
    "client": [
      "com.carlschierig.immersivecrafting.ImmersiveCraftingFabricClient"
    ],
    "fabric-datagen": [
      "com.carlschierig.immersivecrafting.impl.datagen.ICDatagen"
    ],
    "jei_mod_plugin": [
      "com.carlschierig.immersivecrafting.compat.client.jei.ICJeiPlugin"
    ]
  },
  "mixins": [
    "immersive-crafting.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${version_fabricloader}",
    "fabric-api": "*",
    "minecraft": "${version_minecraft}",
    "java": ">=${version_java}"
  }
}
